@startuml seq_01_register
' ============================================
' SEQUENCE DIAGRAM — Register Akun Baru
' ============================================

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequence {
  ArrowColor #78350F
  ActorBorderColor #8B1A1A
  LifeLineBorderColor #D4A017
  LifeLineBackgroundColor #FDF6E3
  ParticipantBorderColor #8B1A1A
  ParticipantBackgroundColor #FDF6E3
  ParticipantFontStyle bold
  GroupBorderColor #D4A017
  DividerBorderColor #8B1A1A
}

title **Sequence Diagram — Register Akun Baru**

actor "Pengguna" as U
participant "RegisterScreen" as RS
participant "AuthRepository" as AR
participant "EncryptionService" as ES
participant "HiveService\n(userBox)" as HS
participant "SecureStorage" as SS
participant "SessionManager" as SM

== Proses Registrasi ==

U -> RS : Input username, password,\nkonfirmasi password
activate RS

RS -> RS : Validasi input\n(format, panjang, kecocokan)

alt #FFE0E0 Validasi gagal
  RS --> U : Tampilkan pesan error
else #E8F5E9 Validasi berhasil
  RS -> AR : register(username, password)
  activate AR

  AR -> HS : getUser(username)
  activate HS
  HS --> AR : null / existing user
  deactivate HS

  alt #FFE0E0 Username sudah dipakai
    AR --> RS : throw DuplicateUserException
    RS --> U : "Username sudah terdaftar"
  else #E8F5E9 Username tersedia

    == Enkripsi Password ==
    AR -> ES : generateSalt()
    activate ES
    ES --> AR : salt (random bytes)
    deactivate ES

    AR -> ES : hashPassword(password, salt)
    activate ES
    note right of ES
      SHA-256 + salt unik per user
      hash = SHA256(password + salt)
    end note
    ES --> AR : hashedPassword
    deactivate ES

    == Simpan Data User ==
    AR -> SS : storeSalt(userId, salt)
    activate SS
    SS --> AR : success
    deactivate SS

    AR -> HS : storeUser({\n  userId, username,\n  hashedPassword,\n  level: 1, xp: 0\n})
    activate HS
    HS --> AR : success
    deactivate HS

    == Buat Session ==
    AR -> SM : createJWT(userId)
    activate SM
    note right of SM
      JWT token
      expiry: 7 hari
    end note
    SM --> AR : jwtToken
    deactivate SM

    AR -> ES : encryptAES(jwtToken)
    activate ES
    ES --> AR : encryptedToken
    deactivate ES

    AR -> SS : storeToken(encryptedToken)
    activate SS
    SS --> AR : success
    deactivate SS

    AR --> RS : RegisterResult.success
  end
  deactivate AR

  RS --> U : Navigasi ke HomeScreen
  note over U : Tawarkan setup biometrik
end
deactivate RS

@enduml
